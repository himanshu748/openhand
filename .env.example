# Server and all transactions are restricted to Solana devnet.
SOLANA_RPC_URL=https://api.devnet.solana.com
PORT=3000

# Optional AI selection of ledger events. Sentences are rendered from checked data.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# Optional audio. Public requests can only speak a cached, checked ledger update.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# LOCAL SEED SCRIPT ONLY. Never configure wallet private keys on the public server.
# OPENHAND_KEYS_PATH=/absolute/path/to/local/demo-keys.json

# Pass It On — all secrets are server-side
PASSITON_SIGNING_KEY=
ELEVENLABS_STT_ENABLED=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_JWT_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_DATABASE=PASSITON
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=PASSITON_WH
SNOWFLAKE_ROLE=PASSITON_APP
