# Solana. Optional: falls back to the public devnet endpoint, which rate limits
# heavily. A free Helius or QuickNode devnet URL makes the demo reliable.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Snowflake. Without these the seven metrics are computed locally and labelled
# as a fallback in the UI. Also run: npm i snowflake-sdk
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Google AI. Without this the donor update falls back to a fixed template.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ElevenLabs. Without this the receipt script is shown but not spoken.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
