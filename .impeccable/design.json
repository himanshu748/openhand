      "html": "<label class=\"ds-label\" for=\"ds-explanation\">Your explanation</label><textarea class=\"ds-input\" id=\"ds-explanation\" placeholder=\"Explain the rule, including any dates or conditions\u2026\"></textarea>",
      "css": ".ds-label{display:block;font:750 13px Manrope,system-ui,sans-serif;margin:20px 0 7px;color:var(--ink,#202c40)}.ds-input{width:100%;font:14px/1.7 Manrope,system-ui,sans-serif;min-height:128px;padding:14px 16px;resize:vertical;border:1px solid var(--rule,#d8dfeb);border-radius:10px;background:var(--paper,#f4f6fa);color:var(--ink,#202c40)}.ds-input:focus-visible{outline:3px solid var(--green,#3455bd);outline-offset:4px}"
    },
